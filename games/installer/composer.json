{
    "name": "jumphp2installer/app",
    "description": "The installer: one executable that installs a package of a jumphp2installer server",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "jumphp/engine": "@dev",
        "jumphp2installer/installer": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../engine"
        },
        {
            "type": "path",
            "url": "../../installer",
            "options": {
                "symlink": false
            }
        },
        {
            "type": "vcs",
            "url": "https://github.com/davidnurdin/php-wasm-network"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform-check": false
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    }
}
