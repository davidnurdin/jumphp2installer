{% extends 'base.html.twig' %}
{% block title %}Sign in · jumphp2installer{% endblock %}
{% block body %}
<form method="post" class="box narrow">
  <h1>Sign in</h1>
  {% if error %}<p class="error">{{ error.messageKey|trans(error.messageData, 'security') }}</p>{% endif %}
  <label>E-mail <input type="email" name="_username" value="{{ last }}" required autofocus autocomplete="email"></label>
  <label>Password <input type="password" name="_password" required autocomplete="current-password"></label>
  <label class="inline"><input type="checkbox" name="_remember_me"> Keep me signed in</label>
  <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
  <button class="primary">Sign in</button>
  <p class="muted">Accounts are made by the server's administrator: <code>bin/console app:user:create you@example.com</code></p>
</form>
{% endblock %}
